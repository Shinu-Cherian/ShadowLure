# Copy this file to .env and fill in real values before running
# `docker compose up`. Never commit the real .env file.

# PostgreSQL password used by both the shadowlure-api and postgres services.
POSTGRES_PASSWORD=change-me-to-a-strong-password

# Optional: enables LLM-generated decoy content and attacker profile
# summaries via Groq. If unset, ShadowLure falls back to deterministic
# built-in templates and still runs correctly.
GROQ_API_KEY=

# Required in Production. Authenticates operator-only actions (deploying
# or revoking canaries, resetting the workspace, running simulations).
# Generate one with: openssl rand -hex 32
OPERATOR_API_KEY=change-me-to-a-random-secret
